# ==============================================================================
# SyncTogether Client Configuration  (copy to `.env`)
# ------------------------------------------------------------------------------
# Compiled into the app as Dart defines - pass the file with
#   flutter run --dart-define-from-file=.env
#   flutter build macos --release --dart-define-from-file=.env
# (or "debug (with .env file)" in VS Code). `scripts/selfhost-verify.py` reads this
# same file, so keep it filled in with the values you really build with.
#
# CLIENT-SAFE VALUES ONLY. Server secrets never go here: they live in
# supabase/functions/.env, supabase/.env and website/.env.local.
#
# Local development needs none of this: a debug build (`./scripts/dev.sh`, then
# `fvm flutter run`) talks to the local Supabase stack and local website by itself.
# There are NO built-in production values: a release build only knows the backend,
# site and support address you give it here.
# ==============================================================================

# --- Backend (REQUIRED for release builds) -----------------------------------
# Supabase Cloud:  https://<project-ref>.supabase.co
# Self-hosted:     https://api.yourdomain.com  (Kong, behind TLS)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# --- Your web portal (REQUIRED for release builds) ---------------------------
# Origin of the deployed `website/`: invite links, recap/profile pages, Terms and
# Privacy, and the Google sign-in bridge are built from it. No trailing slash.
SITE_URL=https://watch.example.com
# Where reports and appeals are sent. Unset hides the "email us" lines.
SUPPORT_EMAIL=help@example.com

# --- Debug-only local stack (optional) ---------------------------------------
# A debug build prefers these over SUPABASE_URL so it can never touch your real
# project. Unset, debug builds use http://127.0.0.1:54321 with the local key.
SUPABASE_URL_LOCAL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY_LOCAL=sb_publishable_xxxxx

# --- Voice / video facecams (optional) ---------------------------------------
# LiveKit WebSocket URL. Unset or empty: facecams are hidden. Must be a host in
# the endpoints you configured for the livekit-token function.
# Cloud: wss://<subdomain>.livekit.cloud     Self-hosted: wss://av.yourdomain.com
LIVEKIT_URL=

# --- Guest sign-in captcha (optional) ----------------------------------------
# Cloudflare Turnstile SITE key. REQUIRED if [auth.captcha] is enabled on your
# Supabase project (the server then rejects guest sign-in without a token); leave
# empty if captcha is off. Local dev uses Turnstile's test key automatically.
TURNSTILE_SITE_KEY=

# --- Telemetry (optional; each is off when empty) ----------------------------
# Public, write-only client keys - not secrets.
SENTRY_DSN=
POSTHOG_API_KEY=
# Defaults to https://us.i.posthog.com
POSTHOG_HOST=
