# ==============================================================================
# SyncTogether Client Environment Configuration
# ------------------------------------------------------------------------------
# OPTIONAL FOR LOCAL DEV: Local debug builds (`./scripts/dev.sh` or `fvm flutter run`)
# automatically connect to the local Supabase stack (http://127.0.0.1:54321) with
# built-in defaults when this file is omitted.
#
# If you wish to override local defaults or point to a custom remote environment,
# copy this file to `.env` and pass:
#   flutter run --dart-define-from-file=.env
# (or select "debug (with .env file)" in VS Code).
#
# NOTE: Client-safe values ONLY. Values are compiled into the app via Dart defines.
# Server secrets must NEVER be added here (use supabase/functions/.env or Vercel instead).
# ==============================================================================

# Supabase Production / Self-Hosted Backend (Required for Release Builds)
# Cloud: https://<project-ref>.supabase.co
# Self-Hosted: https://api.yourdomain.com (or LAN IP)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# Local Development Fallbacks (Optional)
# Debug builds automatically prefer these when set.
# If unset in debug mode, Env defaults to http://127.0.0.1:54321 automatically.
SUPABASE_URL_LOCAL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY_LOCAL=sb_publishable_xxxxx

# LiveKit Audio/Video Mesh (Optional)
# Enables voice facecam tiles and 360p video facecams.
# Cloud: wss://<subdomain>.livekit.cloud
# Self-Hosted: ws://127.0.0.1:7880 or wss://livekit.yourdomain.com
# If omitted or empty, AV facecam features are gracefully hidden.
LIVEKIT_URL=wss://xxxxx.livekit.cloud

# Cloudflare Turnstile Captcha (Optional)
# Protects anonymous guest account creation against bot floods.
# For local dev testing, Turnstile's test key is used by default: 1x00000000000000000000AA
TURNSTILE_SITE_KEY=0x4AAAAAA...

# Sentry Crash Reporting (Optional)
# Write-only public client DSN for crash reports. Disabled when omitted.
SENTRY_DSN=https://xxxxx@o0000000.ingest.sentry.io/0000000

# PostHog Product Telemetry (Optional)
# Write-only public project key. Disabled when omitted.
POSTHOG_API_KEY=phc_xxxxx
# PostHog Host: defaults to https://us.i.posthog.com (use https://eu.i.posthog.com or self-hosted endpoint)
POSTHOG_HOST=https://us.i.posthog.com

# ==============================================================================
# Platform-Native Secrets Architecture
# ------------------------------------------------------------------------------
# 1. Flutter Client:
#    Injected at compile-time via --dart-define. Zero plaintext asset bundling.
#
# 2. GitHub Actions CI Secrets (Set in GitHub Repo Settings > Secrets):
#    - APPLE_ID, APPLE_TEAM_ID, APPLE_APP_SPECIFIC_PASSWORD
#    - MACOS_CERTIFICATE_BASE64, MACOS_CERTIFICATE_PASSWORD
#    - SPARKLE_ED_PRIVATE_KEY
#    - WINSPARKLE_DSA_PRIVATE_KEY
#    - SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, LIVEKIT_URL, etc.
#    - ENTRA_TENANT_ID, ENTRA_CLIENT_ID, ENTRA_CLIENT_SECRET, MSSTORE_*
#
# 3. Backend & Edge Function Secrets (Set via `supabase secrets set`):
#    - LIVEKIT_API_KEY, LIVEKIT_API_SECRET
#    - CF_R2_ACCESS_KEY_ID, CF_R2_SECRET_ACCESS_KEY, CF_R2_ENDPOINT, CF_R2_BUCKET_NAME
#
# 4. Web Portal & Billing (Set in Vercel / hosting environment variables):
#    - PADDLE_API_KEY, PADDLE_WEBHOOK_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY
# ==============================================================================
