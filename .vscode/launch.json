{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "debug (with .env file)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define-from-file=.env"
            ]
        },
        {
            "name": "debug (store mode with .env file)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define-from-file=.env",
                "--dart-define=STORE_BUILD=true"
            ]
        },
        {
            "name": "release (store mode with .env file)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--dart-define-from-file=.env",
                "--dart-define=STORE_BUILD=true"
            ]
        },
        {
            "name": "Demo Mode",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=DEMO_MODE=true"
            ]
        },
        {
            "name": "Demo Mode: Watch Room",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=DEMO_MODE=true",
                "--dart-define=DEMO_ROOM=true"
            ]
        },
        {
            "name": "debug (iOS Device - LAN Backend)",
            "request": "launch",
            "type": "dart",
            "deviceId": "ios",
            "args": [
                "--dart-define-from-file=.env",
                "--dart-define=SUPABASE_URL_LOCAL=http://Shubhams-Mac-mini.local:54321"
            ]
        }
    ]
}