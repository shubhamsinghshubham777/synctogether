<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-only app: one theme for both OS modes (no values-night override). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Shown until the Flutter engine draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window colour while Flutter initializes and behind the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/canvas</item>
    </style>
</resources>
