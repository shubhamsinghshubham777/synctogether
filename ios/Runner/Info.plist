			<array>
				<string>synctogether</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>SyncTogether uses your camera for taking profile photos and for video facecams during watch parties.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>SyncTogether uses your microphone for voice chat during watch parties.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>SyncTogether uses your local network to find the best direct connection for voice and video with the friends in your room.</string>
	<!-- NSAllowsLocalNetworking only (never NSAllowsArbitraryLoads): the YouTube
	     embed and Turnstile challenge are served to the WebView from a throwaway
	     http server on 127.0.0.1, and `scripts/run-ios.sh` reaches a LAN backend.
	     Every remote host (Supabase, LiveKit, R2) stays on enforced HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- audio keeps the room's playback and voice chat alive when the app is
	     backgrounded. Deliberately not voip: that mode is reserved for CallKit /
	     PushKit calling apps and invites a rejection under guideline 2.5.4. -->
	<!-- Add to Calendar. iOS 17+ shows the system event editor with no permission; on
	     iOS 15-16 the editor needs calendar access, asked for only at that moment. -->
	<key>NSCalendarsUsageDescription</key>
	<string>SyncTogether adds a date night to your calendar when you ask it to.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>SyncTogether adds a date night to your calendar when you ask it to. It never reads your calendar.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
