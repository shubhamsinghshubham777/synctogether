# ==============================================================================
# Supabase Edge Functions Secrets
# ------------------------------------------------------------------------------
# Set in Supabase Cloud via:
#   supabase secrets set --env-file supabase/functions/.env
# Or loaded locally via:
#   supabase functions serve --env-file supabase/functions/.env
# ==============================================================================

# LiveKit SFU (Required for livekit-token function)
# Cloud: wss://<subdomain>.livekit.cloud
# Self-Hosted: ws://127.0.0.1:7880 or wss://livekit.yourdomain.com
# Keys must match the keys declared in your LiveKit server configuration.
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>
LIVEKIT_URL=wss://xxxxx.livekit.cloud
# Optional override for the single-endpoint legacy config (omitted defaults to
# on everywhere except *.livekit.cloud):
# LIVEKIT_TRIAL=true

# Optional: several LiveKit-protocol endpoints, in priority order. When set it
# replaces the three LIVEKIT_* values above. A room is pinned to one endpoint
# and moves to the next when its endpoint refuses (e.g. a free LiveKit Cloud
# project past its monthly cap) or stops answering. Ids are permanent labels.
# Optional "trial": true/false per entry says whether free rooms' video trial
# may run there; omitted, it is on everywhere except *.livekit.cloud.
# Local/staging only - never production: lets debug builds switch endpoints by hand.
# AV_DEBUG_SWITCHING=true
# LIVEKIT_ENDPOINTS=[{"id":"self","url":"wss://livekit.yourdomain.com","key":"...","secret":"..."},{"id":"cloud","url":"wss://xxxxx.livekit.cloud","key":"...","secret":"..."}]

# Cloudflare R2 / S3 Storage (Optional - for media-share & cleanup-r2 functions)
CF_R2_ENDPOINT=https://<YOUR_ACCOUNT_ID>.r2.cloudflarestorage.com
CF_R2_ACCESS_KEY_ID=<YOUR_ACCESS_KEY_ID>
CF_R2_SECRET_ACCESS_KEY=<YOUR_SECRET_ACCESS_KEY>
CF_R2_BUCKET_NAME=synctogether-media
# Optional: sign stream URLs for the media-edge Worker (docs/media-edge.md). Also needs app_settings.media_edge.enabled.
# MEDIA_EDGE_SECRET=<openssl rand -base64 48>

# Apple In-App Purchase (Required for apple-iap function)
# Bundle id of the Mac App Store app, and its numeric Apple ID from
# App Store Connect > App Information. The Apple ID is required to verify
# Production transactions; without it only Sandbox verifies.
APPLE_BUNDLE_ID=<your.macos.app.bundle.id>
APPLE_APP_APPLE_ID=

# Microsoft Store In-App Purchase (Required for ms-iap function)
# An Entra (Azure AD) app registered against your Partner Center account, and
# the comma-separated Store ids of the subscription add-on(s) you created.
MS_STORE_TENANT_ID=
MS_STORE_CLIENT_ID=
MS_STORE_CLIENT_SECRET=
MS_STORE_PRODUCT_IDS=

# Push notifications (Optional - the push-dispatch function)
# Every platform is optional: a platform with no credentials here is skipped, and
# the app simply never offers to turn push on for it. Without any of these the
# rest of the app is unchanged.
#
# iOS and macOS (APNs): an APNs auth key (.p8) from Apple Developer > Keys. Put
# the key on one line with literal \n for the line breaks. The topic is the
# app's bundle id; set APNS_TOPIC_IOS / APNS_TOPIC_MACOS if the two differ.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=<contents of the .p8 file, each line break written as \n>
# APNS_BUNDLE_ID=<your.app.bundle.id>
# APNS_TOPIC_IOS=
# APNS_TOPIC_MACOS=
#
# Android (FCM HTTP v1): the whole service-account JSON of your Firebase project,
# on one line. The client side needs the matching FIREBASE_* dart-defines.
# FCM_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"..."}
#
# Windows (WNS): the Package SID and secret from Partner Center > App management >
# WNS/MPNS (the package must be Store-associated).
# WNS_PACKAGE_SID=ms-app://s-1-15-2-...
# WNS_CLIENT_SECRET=
