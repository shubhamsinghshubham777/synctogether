# ==============================================================================
# SyncTogether Web Portal & Landing Page Configuration
# ------------------------------------------------------------------------------
# Copy to `website/.env.local` for local development or set in deployment env.
# ==============================================================================

# Supabase Connection (Required)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# Mission Control / Internal Admin Telemetry (Required for /admin and /internal/metrics)
# The admin metrics dashboard strictly runs against production data and refuses to operate
# on local loopback seed data (127.0.0.1:54321). Set your live production project credentials here:
PROD_SUPABASE_URL=https://<your-project-ref>.supabase.co
PROD_SUPABASE_SERVICE_ROLE_KEY=sb_production_service_role_xxxxx

# Optional: your plan's DB cap, so DB size is shown as a percentage (unset = size only)
# SUPABASE_DB_CAP_BYTES=524288000
# Optional: real R2 storage on /internal/metrics (unset = the card says "not measured").
# Token needs the permission "Workers R2 Storage: Read".
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Optional: fixed INR per USD for the MRR USD-equivalent line (default 88)
# METRICS_INR_PER_USD=88
# Optional: your PostHog project URL, linked for the product funnel
# POSTHOG_PROJECT_URL=https://us.posthog.com/project/<id>

# Optional: raise the GitHub API rate limit for the release lookup (unauthenticated works, just limited)
# GITHUB_TOKEN=

# Optional: live App Store prices on /pricing via an App Store Connect API key
# (unset = the site falls back to its built-in USD price). APPLE_APP_APPLE_ID overrides the default app id.
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_PRIVATE_KEY=
# APPLE_APP_APPLE_ID=

# Web Site URL (REQUIRED for a production build - there is no built-in value)
# Invite links, canonical URLs, sitemap and the Google sign-in bridge use it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contact addresses shown on the site and the legal pages (REQUIRED for a production build)
NEXT_PUBLIC_SUPPORT_EMAIL=support@localhost
NEXT_PUBLIC_COPYRIGHT_EMAIL=copyright@localhost

# Cloudflare Turnstile Captcha (Optional for self-hosters; required if [auth.captcha] is enabled in Supabase)
# For local development with dev.sh, Cloudflare's always-pass test key 1x00000000000000000000AA is used.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# PostHog Telemetry (Optional - disabled when omitted)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Homepage Numeric Trust Strip (Optional - non-numeric strip ships regardless; this
# flips on the numeric variant once usage is large enough to be worth publishing.
# /api/public/stats independently suppresses the figures below their floors either way.)
NEXT_PUBLIC_SHOW_USAGE_STATS=false

# Who runs this site (REQUIRED for a production build - the legal pages name the operator)
NEXT_PUBLIC_OPERATOR_NAME=Your Name or Company
# Postal address for copyright notices, lines separated by "|"
NEXT_PUBLIC_OPERATOR_ADDRESS=1 Example Street|Springfield 00000|Country
# Country whose law governs the Terms (a legal choice - have a lawyer confirm it)
NEXT_PUBLIC_GOVERNING_LAW=Your Country
# Optional: a page about you (shown as a link in the footer credits)
NEXT_PUBLIC_OPERATOR_URL=
# Optional: your X/Twitter handle (with the @) for link-preview cards
NEXT_PUBLIC_OPERATOR_TWITTER=
# Optional: your U.S. Copyright Office DMCA agent registration number. Leave empty unless you registered one:
# the DMCA page only says an agent is registered when this is set.
NEXT_PUBLIC_DMCA_REGISTRATION=
# Optional: where people get the client. Unset, the buttons lead to this site's own /download page.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_MICROSOFT_STORE_URL=
