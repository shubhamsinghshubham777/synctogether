# ==============================================================================
# SyncTogether Web Portal & Landing Page Configuration
# ------------------------------------------------------------------------------
# Copy to `website/.env.local` for local development or set in deployment env.
# ==============================================================================

# Supabase Connection (Required)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# Mission Control / Internal Admin Telemetry (Required for /admin and /internal/metrics)
# The admin metrics dashboard strictly runs against production data and refuses to operate
# on local loopback seed data (127.0.0.1:54321). Set your live production project credentials here:
PROD_SUPABASE_URL=https://<your-project-ref>.supabase.co
PROD_SUPABASE_SERVICE_ROLE_KEY=sb_production_service_role_xxxxx

# Optional: your plan's DB cap, so DB size is shown as a percentage (unset = size only)
# SUPABASE_DB_CAP_BYTES=524288000
# Optional: fixed INR per USD for the MRR USD-equivalent line (default 88)
# METRICS_INR_PER_USD=88
# Optional: your PostHog project URL, linked for the product funnel
# POSTHOG_PROJECT_URL=https://us.posthog.com/project/<id>

# Web Site URL (Required for invite links & OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile Captcha (Optional for self-hosters; required if [auth.captcha] is enabled in Supabase)
# For local development with dev.sh, Cloudflare's always-pass test key 1x00000000000000000000AA is used.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# PostHog Telemetry (Optional - disabled when omitted)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Homepage Numeric Trust Strip (Optional - non-numeric strip ships regardless; this
# flips on the numeric variant once usage is large enough to be worth publishing.
# /api/public/stats independently suppresses the figures below their floors either way.)
NEXT_PUBLIC_SHOW_USAGE_STATS=false
