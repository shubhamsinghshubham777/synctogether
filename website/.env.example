# ==============================================================================
# SyncTogether Web Portal & Landing Page Configuration
# ------------------------------------------------------------------------------
# Copy to `website/.env.local` for local development or set in deployment env.
# ==============================================================================

# Supabase Connection (Required)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# Web Site URL (Required for invite links & OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paddle Billing (Optional - only required if offering commercial paid subscriptions)
# Leave blank or omit for standard self-hosted instances.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_client_token_here
NEXT_PUBLIC_PADDLE_MONTHLY_PRICE_ID=pri_monthly_xxx
NEXT_PUBLIC_PADDLE_ANNUAL_PRICE_ID=pri_annual_xxx
PADDLE_API_KEY=pdl_apikey_xxx
PADDLE_WEBHOOK_SECRET_KEY=pdl_ntfset_xxx

# Cloudflare Turnstile Captcha (Optional for self-hosters; required if [auth.captcha] is enabled in Supabase)
# For local development with dev.sh, Cloudflare's always-pass test key 1x00000000000000000000AA is used.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# PostHog Telemetry (Optional - disabled when omitted)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
